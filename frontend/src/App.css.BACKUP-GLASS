/* ===== RESET ===== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html, body, #root {
  width: 100%;
  min-height: 100vh;
}

body {
  background: #050505;
  color: white;
  font-family: 'Segoe UI', system-ui, -apple-system, Arial, sans-serif;
  line-height: 1.5;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ===== APP SHELL ===== */
.app-shell {
  width: 100%;
  min-height: 100vh;
  background: #050505;
}

/* ===== HEADER ===== */
.header {
  height: 90px;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #0b0b0b;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30px;
  z-index: 1000;
  font-size: 18px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

/* ===== BODY ===== */
.app-body {
  display: flex;
  width: 100%;
  min-height: calc(100vh - 90px);
  padding-top: 90px;
}

/* ===== SIDEBAR ===== */
.sidebar {
  width: 190px;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-right: 1px solid rgba(255, 255, 255, 0.1);
  position: fixed;
  top: 90px;
  left: 0;
  height: calc(100vh - 90px);
  padding: 20px 12px;
  z-index: 900;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  overflow-y: auto;
}

.sidebar.closed {
  transform: translateX(-100%);
}

.sidebar.open {
  transform: translateX(0);
}

.sidebar-link {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 14px;
  margin-bottom: 6px;
  color: white;
  text-decoration: none;
  border-radius: 12px;
  transition: 0.25s ease;
  font-size: 0.95rem;
  overflow: hidden;
}

.sidebar-link:hover {
  background: rgba(255, 255, 255, 0.06);
}

.sidebar-link.active {
  background: linear-gradient(135deg, #111827, #7c3aed);
  font-weight: 700;
  box-shadow: 0 4px 15px rgba(124, 58, 237, 0.35);
}

.sidebar-link svg {
  width: 22px;
  height: 22px;
  flex-shrink: 0;
  color: white;
  stroke: white;
}

/* ===== CONTENU ===== */
.page-content {
  flex: 1;
  margin-left: 190px;
  padding: 24px;
  min-height: calc(100vh - 90px);
  overflow-x: hidden;
  transition: margin-left 0.35s ease;
}

/* Quand la sidebar est fermée */
.sidebar.closed ~ .page-content,
.app-body:has(.sidebar.closed) .page-content {
  margin-left: 0;
}

/* ===== CARTES FEFO ===== */
.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-top: 28px;
  width: 100%;
}

.card-fefo {
  background: linear-gradient(145deg, #151515, #080808);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 16px;
  padding: 22px;
  min-height: 120px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  transition: 0.25s ease;
}

.card-fefo:hover {
  border-color: #00ff88;
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0, 255, 136, 0.15);
}

.card-fefo h3 {
  color: #aaa;
  margin: 0 0 10px;
  font-size: 0.95rem;
  font-weight: 500;
}

.card-fefo strong {
  font-size: 2rem;
  font-weight: 800;
  color: #00ff88;
  letter-spacing: -0.5px;
}

/* ===== BANNER FEFO ===== */
.fefo-banner {
  width: 100%;
  background: linear-gradient(135deg, #0b0b0b, #111827);
  border-radius: 24px;
  padding: 35px;
  border: 1px solid rgba(0, 255, 136, 0.15);
  box-shadow:
    0 20px 50px rgba(0, 0, 0, 0.55),
    inset 0 0 30px rgba(0, 255, 136, 0.05);
  overflow: hidden;
}

.brand-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
  width: 100%;
  flex-wrap: wrap;
}

.fefo-banner h1 {
  margin: 0;
  font-size: 2.6rem;
  font-weight: 900;
  letter-spacing: 1px;
  font-family: "Montserrat", "Segoe UI", Arial, sans-serif;
  background: linear-gradient(90deg, #8b5cf6, #c084fc, #fff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  text-align: center;
  line-height: 1.3;
}

.fefo-banner p {
  margin-top: 12px;
  color: #9ca3af;
  font-size: 1.15rem;
  text-align: center;
}

/* ===== BOX 3D ===== */
.box-3d {
  font-size: 85px;
  display: flex;
  align-items: center;
  justify-content: center;
  filter: drop-shadow(0 0 15px rgba(0, 255, 136, 0.5));
  animation: boxPremium 6s ease-in-out infinite;
}

@keyframes boxPremium {
  0% {
    transform: perspective(500px) rotateX(8deg) rotateY(0deg) translateY(0);
  }
  25% {
    transform: perspective(500px) rotateX(8deg) rotateY(90deg) translateY(-8px);
  }
  50% {
    transform: perspective(500px) rotateX(8deg) rotateY(180deg) translateY(0);
  }
  75% {
    transform: perspective(500px) rotateX(8deg) rotateY(270deg) translateY(-8px);
  }
  100% {
    transform: perspective(500px) rotateX(8deg) rotateY(360deg) translateY(0);
  }
}

/* ===== STATUS FEFO ===== */
.stock-status {
  margin-top: 35px;
}

.status-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  gap: 16px;
}

.status-card {
  padding: 16px;
  border-radius: 15px;
  background: #111;
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.status-card strong {
  font-size: 1.8rem;
}

.normal {
  background: #052e16;
  border-color: #00ff88;
}

.warning {
  background: #451a03;
  border-color: #f59e0b;
}

.danger {
  background: #450a0a;
  border-color: #ef4444;
}

/* ===== SEARCH ===== */
.product-search {
  width: 100%;
  margin: 20px 0 25px;
}

.search-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: #111;
  border: 2px solid #00c853;
  border-radius: 18px;
  cursor: pointer;
  color: #fff;
  font-size: 18px;
  font-weight: 700;
  transition: 0.3s;
}

.search-toggle:hover {
  transform: translateY(-2px);
  box-shadow: 0 0 18px rgba(0, 200, 83, 0.4);
}

.search-box {
  margin-top: 15px;
  padding: 20px;
  background: #181818;
  border-radius: 18px;
  border: 1px solid #333;
}

.search-box input {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 12px;
  margin-bottom: 15px;
  font-size: 16px;
  background: #222;
  color: white;
}

.search-box button {
  width: 100%;
  padding: 14px;
  border: none;
  border-radius: 12px;
  background: #00c853;
  color: #fff;
  font-weight: 700;
  cursor: pointer;
}

/* ===== ACTIONS ===== */
.product-actions {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin: 25px 0;
}

.action-card {
  background: #161616;
  border: 1px solid #2b2b2b;
  border-radius: 18px;
  padding: 22px;
  text-align: center;
  color: white;
  cursor: pointer;
  min-height: 140px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: 0.25s;
}

.action-card svg {
  color: #d4af37;
  width: 34px;
  height: 34px;
  margin-bottom: 12px;
}

.action-card:hover {
  background: #202020;
  transform: translateY(-3px);
  border-color: #555;
  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.6);
}

.action-card h3 {
  margin: 8px 0;
}

.action-card p {
  color: #aaa;
  font-size: 14px;
}

/* ===== FOOTER STATUS ===== */
.footer-status {
  position: fixed;
  bottom: 10px;
  left: 0;
  right: 0;
  display: flex;
  justify-content: flex-start;
  align-items: center;
  gap: 15px;
  padding: 0 20px;
  background: transparent;
  z-index: 50;
}

/* ===== SIGNATURE ===== */
.malizia-signature {
  font-family: "Brush Script MT", "Segoe Script", cursive;
  font-size: 28px;
  font-weight: 700;
  background: linear-gradient(90deg, #8b5cf6, #c084fc, #ffffff);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.app-version {
  color: #aaa;
  font-size: 14px;
  font-weight: 700;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 1100px) {
  .cards {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 900px) {
  .sidebar {
    transform: translateX(-100%);
  }

  .sidebar.open {
    transform: translateX(0);
  }

  .page-content {
    margin-left: 0;
    padding: 16px;
  }

  .cards {
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }
}

@media (max-width: 650px) {
  .header {
    padding: 0 15px;
    font-size: 16px;
  }

  .page-content {
    padding: 15px;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .status-grid {
    grid-template-columns: 1fr;
  }

  .brand-title {
    flex-direction: column;
    gap: 10px;
  }

  .box-3d {
    font-size: 65px;
  }

  .fefo-banner h1 {
    font-size: 1.9rem;
  }

  .product-actions {
    grid-template-columns: 1fr;
  }

  .footer-status {
    gap: 10px;
    font-size: 14px;
  }
}

/* ===== SCROLLBAR ===== */
::-webkit-scrollbar {
  width: 8px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: rgba(0, 255, 136, 0.25);
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover {
  background: rgba(0, 255, 136, 0.45);
}
