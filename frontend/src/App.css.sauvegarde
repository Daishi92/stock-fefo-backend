/* ==========================
   STOCK FEFO PRO
   ENTERPRISE STYLE
========================== */


/* RESET */

* {

  box-sizing:border-box;

}



body {

  margin:0;

  width:100%;

  min-height:100vh;

  background:#050505;

  color:white;

  font-family:Arial, Helvetica, sans-serif;

  overflow-x:hidden;

}
html,
#root {

  width:100%;

  min-height:100vh;

}

/* APPLICATION */

.app-shell {

  min-height:100vh;

  background:#050505;

}

/* HEADER */

.header {

  height:90px;

  position:fixed;

  top:0;

  left:0;

  right:0;

  display:flex;

  justify-content:space-between;

  align-items:center;

  padding:0 30px;

  background:#0b0b0b;

  border-bottom:1px solid rgba(255,255,255,.1);

  z-index:1000;

}


.header-title {

  font-size:22px;

  font-weight:bold;

}


.header-user {

  color:#aaa;

}



/* CORPS */

.app-body {

  display:flex;

  flex-direction:row;

  width:100%;

  padding-top:90px;

  min-height:calc(100vh - 130px);

}

/* 
EBAR */

.sidebar {

  position:fixed;

  top:90px;

  left:0;

  width:240px;

  height:calc(100vh - 90px);

  z-index:1000;

  background:#0a0a0a;

  padding:20px;

  border-right:1px solid rgba(255,255,255,.1);

  overflow-y:auto;

  transition:transform .3s ease, opacity .3s ease;

}

.sidebar-logo {

  font-weight:bold;

  margin-bottom:30px;

  font-size:18px;

}


.sidebar-link {

  display:flex;

  align-items:center;

  gap:12px;

  padding:12px;

  margin-bottom:8px;

  color:white;

  text-decoration:none;

  border-radius:10px;

}


.sidebar-link:hover {

  background:#1a1a1a;

}



/* CONTENU */

.page-content {

  flex:1;

  width:100%;

  padding:20px;
  min-width:0;

}

/* DASHBOARD */

.cards {

  display:grid;

  grid-template-columns:

  repeat(3,minmax(220px,1fr));

  gap:20px;

  margin-top:30px;

}



.card-fefo {

  padding:15px;

  min-height:90px;

  border-radius:14px;

  display:flex;

  flex-direction:column;

  justify-content:center;

}

.card-fefo strong {

  font-size:35px;

}



/* ETAT STOCK */

.status-grid {

  display:grid;

  grid-template-columns:

  repeat(3,1fr);

  gap:20px;

}


.status-card {

  background:#111;

  padding:20px;

  border-radius:15px;

}



/* FOOTER */

.footer-status {

  position:fixed;

  bottom:0;

  left:0;

  right:0;

  height:40px;

  background:#0b0b0b;

  display:flex;

  justify-content:center;

  align-items:center;

  gap:25px;

  border-top:1px solid rgba(255,255,255,.1);

  z-index:1000;

}



/* TABLETTE */

@media(max-width:1000px){


  .cards {

    grid-template-columns:

    repeat(2,1fr);

  }


}



/* MOBILE */

@media(max-width:650px){


  .sidebar {

    width:70px;

    padding:10px;

  }


  .sidebar-link {

    justify-content:center;

    font-size:0;

  }


  .cards {

    grid-template-columns:1fr;

  }


  .status-grid {

    grid-template-columns:1fr;

  }


}


/* ==========================
   DASHBOARD FEFO PREMIUM
========================== */


.dashboard-dark {

  width:100%;

}



/* BANNIERE */

.fefo-banner {

  background:linear-gradient(135deg,#111,#1f2937);

  border-radius:20px;

  padding:30px;

  border:1px solid rgba(255,255,255,.1);

  box-shadow:0 15px 40px rgba(0,0,0,.5);

}


/* BANNIERE PREMIUM AMELIOREE */

.fefo-banner {

  position:relative;

  overflow:hidden;

}


.fefo-banner::before {

  content:"";

  position:absolute;

  top:-80px;

  right:-80px;

  width:220px;

  height:220px;

  background:rgba(0,255,136,.15);

  border-radius:50%;

  filter:blur(30px);

}


.brand-title {

  display:flex;

  align-items:center;

  justify-content:space-between;

  gap:20px;

}





/* STATUT SERVEUR */

.system-status {

  margin-top:20px;

  padding:12px 20px;

  background:#0b0b0b;

  border-radius:12px;

  border-left:4px solid #22c55e;

  color:#22c55e;

}



/* CARTES DASHBOARD */

.cards {

  display:grid;

  grid-template-columns:
  repeat(4,minmax(160px,1fr));

  gap:16px;

  margin-top:25px;

}


.card-fefo {

  background:

  linear-gradient(145deg,#151515,#080808);

  border-radius:18px;

  padding:25px;

  border:1px solid rgba(255,255,255,.08);

  transition:.3s;

}



.card-fefo:hover {

  transform:translateY(-8px);

  border-color:#22c55e;

}



.card-icon {

  width:50px;

  height:50px;

  display:flex;

  align-items:center;

  justify-content:center;

  background:#22c55e;

  border-radius:12px;

  color:#000;

}



.card-fefo h3 {

  color:#aaa;

}



.card-fefo strong {

  font-size:28px;

}


/* ETAT STOCK */

.stock-status {

  margin-top:40px;

}



.status-grid {

  display:grid;

  grid-template-columns:

  repeat(3,1fr);

  gap:20px;

}



.status-card {

  background:#111;

  padding:15px;

  border-radius:12px;

}


.status-card strong {

  font-size:26px;

}


.normal {

  background:#052e16;

  border:1px solid #22c55e;

}



.warning {

  background:#451a03;

  border:1px solid #f59e0b;

}



.danger {

  background:#450a0a;

  border:1px solid #ef4444;

}



/* RESPONSIVE */

@media(max-width:600px){

.cards{

  grid-template-columns:1fr;

}

}


@media(max-width:600px){

  .cards,

  .status-grid {

    grid-template-columns:1fr;

  }


  .brand-title {

    flex-direction:column;

  }

}

/* ==========================
   SIDEBAR TOGGLE
========================== */
.sidebar.closed {

  transform:translateX(-260px);

  opacity:0;

  pointer-events:none;

}


.sidebar.open {

  transform:translateX(0);

  opacity:1;

}

/* ==========================
   SIDEBAR PREMIUM STYLE
========================== */

.sidebar {

  box-shadow: 8px 0 25px rgba(0,0,0,.45);

  backdrop-filter: blur(8px);

}


.sidebar-logo {

  padding:15px;

  background:linear-gradient(135deg,#111,#1d1d1d);

  border-radius:14px;

  text-align:center;

  letter-spacing:1px;

  color:#00ff88;

  box-shadow:0 0 15px rgba(0,255,136,.15);

}


.sidebar-link {

  transition:.25s ease;

  border:1px solid transparent;

}


.sidebar-link:hover {

  transform:translateX(6px);

  background:#151515;

  border-color:rgba(0,255,136,.3);

}


.sidebar-link.active {

  background:linear-gradient(135deg,#00c853,#00ff88);

  color:#000;

  font-weight:bold;

}


.sidebar-link svg {

  width:22px;

  height:22px;

}




.box-3d {

  font-size:90px;

  display:flex;

  align-items:center;

  justify-content:center;

  filter:
  drop-shadow(8px 12px 8px rgba(0,0,0,.45));

  transform:
  perspective(500px)
  rotateX(8deg)
  rotateY(-12deg);

  animation:boxFloat 1.8s ease-in-out infinite;
}

.box-3d:hover {

  transform:perspective(500px)
             rotateX(0deg)
             rotateY(0deg)
             scale(1.05);

}


@keyframes boxFloat {

  0%,100% {

    transform:
    perspective(500px)
    translateY(0)
    rotateX(8deg)
    rotateY(-12deg)
    rotateZ(-8deg);
  }


  50% {

    transform:
    perspective(500px)
    translateY(-22px)
    rotateX(8deg)
    rotateY(-12deg)
    rotateZ(8deg);
  }

}

